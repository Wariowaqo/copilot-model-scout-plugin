# This file includes environment variables that will be committed to git by default.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev
AGENT_SCOPE=shared

# Set these before you provision: your own Model Scout server (see ../server) and publisher details.
# For `--env local`, put the same variables in env/.env.local, which is git-ignored.
MODEL_SCOUT_MCP_URL=https://model-scout-mcp.YOUR-SUBDOMAIN.workers.dev/mcp
DEVELOPER_NAME=Your name
DEVELOPER_WEBSITE_URL=https://example.com
DEVELOPER_PRIVACY_URL=https://example.com/privacy
DEVELOPER_TERMS_URL=https://example.com/terms
# Generated during provision, you can also add your own variables.
TEAMS_APP_ID=